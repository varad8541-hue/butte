{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://cloud.lunarclouds.xyz:25580/api/:path*"
    },
    {
      "source": "/transcripts/:path*",
      "destination": "http://cloud.lunarclouds.xyz:25580/transcripts/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
